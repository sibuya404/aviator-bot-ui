# Example .env

# START_MODE=simulate  (simulate-only server start)
# LIVE=true to enable live adapter when calling /api/adapter/1xbet/start with live:true
# HEADFUL=true  (set to false to run browser headless)
# DRY_RUN=true  (if true, adapter will NOT place real bets even in live mode)

# ONE_XBET_URL=https://1xbet.com/aviator
# LOGIN_USERNAME=your_username
# LOGIN_PASSWORD=your_password

