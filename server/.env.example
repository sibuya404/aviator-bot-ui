# Example .env

# START_MODE=live  (live server start)
# LIVE=true to enable live betting (set to false for simulate-only)
# HEADFUL=true  (set to false to run browser headless)
# DRY_RUN=false  (if false, adapter will place real bets in live mode)

ONE_XBET_URL=https://1xbet.com/aviator
LOGIN_USERNAME=your_username
LOGIN_PASSWORD=your_password
START_MODE=live
LIVE=true
HEADFUL=false
DRY_RUN=false
